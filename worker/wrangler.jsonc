{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rule",
  "account_id": "b20475c3bde49b1094984a02073aa368",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "upload_source_maps": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "DOWNLOAD_TOKEN"
    ]
  },
  "routes": [
    {
      "pattern": "rule.dehors.cloud",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
